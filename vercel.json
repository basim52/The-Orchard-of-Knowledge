{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "data/**",
          "dist/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "dist/assets/$1",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
        }
    },
    {
      "src": "/(.*)",
      "dest": "api/index.ts"
    }
  ]
}
