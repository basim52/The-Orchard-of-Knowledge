rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Progress validation
    function isValidProgress(data) {
      return data.userId == request.auth.uid
        && data.updatedAt == request.time;
    }

    // Custom Book validation
    function isValidCustomBook(data) {
      return data.id is string && data.id.size() <= 128
        && data.userId == request.auth.uid
        && data.title is string && data.title.size() <= 200
        && data.author is string && data.author.size() <= 200
        && data.cover is string && data.cover.size() <= 100
        && data.essence is string && data.essence.size() <= 1000
        && data.mindsetShifts is list && data.mindsetShifts.size() <= 50
        && data.trunk is string && data.trunk.size() <= 500
        && data.branches is list && data.branches.size() <= 20
        && data.challenges is list && data.challenges.size() <= 20
        && data.quotes is list && data.quotes.size() <= 20
        && data.createdAt == request.time;
    }

    // User Resource Space
    match /users/{userId} {
      
      match /progress/data {
        allow get: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidProgress(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /customBooks/{bookId} {
        allow get: if isOwner(userId) && isValidId(bookId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(bookId) && isValidCustomBook(request.resource.data);
        allow update: if isOwner(userId) && isValidId(bookId) && isValidCustomBook(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt; // Immutability
        allow delete: if isOwner(userId) && isValidId(bookId);
      }
    }
  }
}
